<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BanknoteIndentifier" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.BanknoteIndentifier" parent="Base.Theme.BanknoteIndentifier" />
    <style name="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>"
    </style>

    <style name="ToolbarTitleStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
    </style>

<!-- SemiBold-->

    <style name="h4SemiBold">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="bodyLargeSemiBold">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="bodyMediumSemiBold">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="bodySmallSemiBold">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="bodyLargeSemiBold.PrimaryDark">
        <item name="android:textColor">@color/color_primary_dark</item>
    </style>

    <style name="bodyMediumSemiBold.PrimaryDark">
        <item name="android:textColor">@color/color_primary_dark</item>
    </style>

<!-- Medium-->
    <style name="bodyLargeMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="bodyMediumMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="bodySmallMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="bodyMediumMedium.PrimaryDark">
        <item name="android:textColor">@color/color_primary_dark</item>
    </style>

<!-- Regular-->
    <style name="bodyMediumRegular">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="bodySmallRegular">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="bodyXSSmallRegular">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">8sp</item>
    </style>

    <style name="bodyMediumRegular.PrimaryDark">
        <item name="android:textColor">@color/color_primary_dark</item>
    </style>

<!-- Search-->

    <style name="SearchTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/color_primary_dark_hint</item>
    </style>

</resources>