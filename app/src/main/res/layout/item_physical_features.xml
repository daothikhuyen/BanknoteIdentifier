<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingBottom="@dimen/spacing_m">

    <!-- Composition -->
    <TextView
        android:id="@+id/tvType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Name"
        style="@style/bodySmallMedium"
        android:textColor="@color/color_primary_dark"
        app:layout_constraintEnd_toStartOf="@+id/tvValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1.5" />

    <TextView
        android:id="@+id/tvValue"
        style="@style/bodyMediumMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Autralian EURO Cent 3355 .trutrali EURO Cent 3355 . "
        app:layout_constraintBaseline_toBaselineOf="@id/tvType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toEndOf="@+id/tvType"/>

</androidx.constraintlayout.widget.ConstraintLayout>