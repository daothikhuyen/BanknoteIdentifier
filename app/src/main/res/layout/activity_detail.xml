<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary_secondary"
    android:fitsSystemWindows="true"
    tools:context=".ui.detail.DetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_24dp"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Banknote Info"
        app:titleTextAppearance="@style/ToolbarTitleStyle" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/diem_8"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/diem_8">

            <ImageView
                android:id="@+id/imgMoneyOne"
                android:layout_width="168dp"
                android:layout_height="80.5dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_empty" />

            <ImageView
                android:id="@+id/imgMoneyTwo"
                android:layout_width="168dp"
                android:layout_height="80.5dp"
                android:layout_marginBottom="@dimen/diem_4"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_empty" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/diem_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/diem_16"
                app:cardElevation="3dp"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@string/detail_title"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/diem_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/diem_16"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/diem_16">

                    <ImageView
                        android:id="@+id/imgReference"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_money_rounded_24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvReferencePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/diem_8"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/reference_price"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/imgReference"
                        app:layout_constraintStart_toEndOf="@id/imgReference"
                        app:layout_constraintTop_toTopOf="@id/imgReference" />

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/diem_16"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:gravity="center"
                        android:text="$200-$600"
                        android:textColor="@color/color_primary_dark"
                        android:textSize="18sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgReference" />

                    <TextView
                        android:id="@+id/tvYearLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/diem_16"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="Year"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPrice" />

                    <TextView
                        android:id="@+id/tvYearValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="1975"
                        android:textSize="16sp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvYearLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvValueLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/diem_8"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="Value"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvYearLabel" />

                    <TextView
                        android:id="@+id/tvValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="100$"
                        android:textSize="16sp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvValueLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/diem_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/diem_16"
                app:cardElevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/diem_16">

                    <ImageView
                        android:id="@+id/ivIconMoneyTwo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_money_rounded_24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/description"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconMoneyTwo"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/diem_8"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="Each Federal Reserve note includes identifiers that provide information about the note, such as designating the year in which the note’s design was approved."
                        android:textSize="16sp"
                        app:layout_constraintTop_toBottomOf="@+id/ivIconMoneyTwo" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardViewFour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/diem_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/diem_16"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/diem_16">

                    <ImageView
                        android:id="@+id/imgIconMoneyFour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_money_rounded_24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPhysicalFeatures"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/diem_8"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/physical_features"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/imgIconMoneyFour"
                        app:layout_constraintStart_toEndOf="@id/imgIconMoneyFour"
                        app:layout_constraintTop_toTopOf="@id/imgIconMoneyFour" />

                    <!-- feature -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPhysicalFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/diem_16"
                        app:layout_constraintHorizontal_weight="1.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgIconMoneyFour" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/diem_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/diem_16"
                app:cardElevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/diem_16">

                    <ImageView
                        android:id="@+id/ivIconMoney"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_money_rounded_24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/lettering"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@+id/ivIconMoney"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/tvLettering"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/diem_8"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="Each Federal Reserve note includes identifiers that provide information about the note, such as designating the year in which the note’s design was approved."
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@+id/ivIconMoney" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <Button
            android:id="@+id/btnAddCollection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/diem_16"
            android:layout_marginVertical="@dimen/diem_8"
            android:layout_marginTop="@dimen/diem_8"
            android:background="@drawable/bg_button_add"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:text="@string/add_to_collection"
            android:textColor="@color/color_primary_dark"
            android:textSize="18sp"
            app:backgroundTint="@null" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>